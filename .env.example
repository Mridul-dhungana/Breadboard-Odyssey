# Copy to .env and fill in (never commit .env)

# Google Gemini — required for "Analyze signal with Gemini"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Arduino UNO Q / Uno USB serial
# Leave empty to auto-detect (ACM / usbmodem / Arduino VID).
# Linux: /dev/ttyACM0   macOS: /dev/cu.usbmodem*   Windows: COM3
ARDUINO_PORT=
ARDUINO_BAUD=115200
ARDUINO_AUTODETECT=1
PREFER_ARDUINO=1
# Set to 1 only if you intentionally want fake waveforms when Arduino fails
ALLOW_MOCK_SCOPE=0

PORT=8765
