# Copy to .env and fill in (never commit .env)

# Google Gemini — coach uses this for natural-language next steps
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Arduino UNO Q / Uno USB serial (leave empty to use mock voltages)
# Linux: /dev/ttyACM0   macOS: /dev/cu.usbmodem*   Windows: COM3
ARDUINO_PORT=
ARDUINO_BAUD=115200
# PREFER_ARDUINO=1

PORT=8765
