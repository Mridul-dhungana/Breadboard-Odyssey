# Copy to .env and fill in (never commit .env)

# Google Gemini — required for "Analyze signal with Gemini"
GEMINI_API_KEY=
# Prefer a current alias; retired ids like gemini-1.5-flash will 404.
GEMINI_MODEL=gemini-flash-latest

# Arduino UNO Q / Uno USB serial (required for LIVE scope / measure)
# Leave empty to auto-detect (ACM / usbmodem / Arduino VID).
# Linux: /dev/ttyACM0   macOS: /dev/cu.usbmodem*   Windows: COM3
ARDUINO_PORT=
ARDUINO_BAUD=115200
ARDUINO_AUTODETECT=1

PORT=8765
